{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unfolded",
  "compatibility_date": "2026-08-01",
  "main": "worker/index.ts",
  "routes": [
    { "pattern": "tryunfolded.com", "custom_domain": true },
    { "pattern": "www.tryunfolded.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionDO" },
      { "name": "PAIRING", "class_name": "PairingDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-live-sync",
      "new_sqlite_classes": ["SessionDO", "PairingDO"]
    }
  ]
}
