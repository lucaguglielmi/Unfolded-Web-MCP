{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unfolded",
  "compatibility_date": "2026-08-01",
  "main": "worker.js",
  "routes": [
    { "pattern": "tryunfolded.com", "custom_domain": true },
    { "pattern": "www.tryunfolded.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
