# Public build-time configuration — every VITE_-prefixed value is inlined
# into the client bundle and visible to anyone, so nothing secret belongs
# in any .env file of this project.
#
# This file is committed and doubles as the DEFAULT: vite.config.ts reads
# it for any VITE_ variable the environment doesn't set, so a clean
# checkout and CI build with these values. A local .env (git-ignored)
# overrides them.

# The one authoritative place the deployed origin is written down. Used
# only for the absolute og:url / og:image tags in index.html (crawlers
# need absolute URLs; everything else in the app is origin-independent).
# Change this when the domain moves.
VITE_SITE_URL=https://tryunfolded.com
