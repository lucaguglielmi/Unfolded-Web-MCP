{
  "name": "unfolded",
  "description": "WebMCP-native parametric designer for slab-built pottery — design in 3D, print true-scale templates, build in clay. Live at https://tryunfolded.com",
  "license": "MIT",
  "repository": "github:lucaguglielmi/Unfolded-Web-MCP",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build --workspace webmcp-profiler && node e2e/sync-demo.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "pree2e": "npm run build --workspace webmcp-profiler",
    "e2e": "node e2e/run.mjs",
    "e2e:worker": "node e2e/worker-smoke.mjs",
    "e2e:pairing": "node e2e/pairing.mjs",
    "preperf": "npm run build --workspace webmcp-profiler",
    "perf": "node e2e/perf.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.34.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svg2pdf.js": "^2.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "ajv": "^8.20.0",
    "happy-dom": "^20.13.2",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "publint": "^0.3.24",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
